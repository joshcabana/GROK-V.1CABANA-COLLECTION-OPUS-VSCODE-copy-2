{
  "name": "cabana-collection-website",
  "version": "1.0.0",
  "description": "CABANA Collection - Conscious Underwear Brand Website",
  "main": "index.html",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lhci:ci": "lhci autorun --config=./lighthouserc.cjs",
    "print:lhci": "node scripts/print-lhci-opportunities.cjs",
    "lhci:mobile": "cross-env CABANA_LHCI_PRESET=mobile lhci autorun --config=./lighthouserc.cjs",
    "lhci:desktop": "cross-env CABANA_LHCI_PRESET=desktop lhci autorun --config=./lighthouserc.cjs",
    "lhci:all": "npm run lhci:mobile && npm run lhci:desktop",
    "perf:dashboard:mobile": "cross-env CABANA_LHCI_PRESET=mobile node scripts/perf-dashboard.cjs",
    "perf:dashboard:desktop": "cross-env CABANA_LHCI_PRESET=desktop node scripts/perf-dashboard.cjs",
    "perf:dashboard": "npm run perf:dashboard:mobile",
    "perf:baseline:mobile": "cross-env CABANA_LHCI_PRESET=mobile node scripts/perf-dashboard.cjs --write-baseline",
    "perf:baseline:desktop": "cross-env CABANA_LHCI_PRESET=desktop node scripts/perf-dashboard.cjs --write-baseline",
    "perf:baseline": "npm run perf:baseline:mobile"
  },
  "keywords": [
    "underwear",
    "sustainable",
    "fashion",
    "eco-friendly"
  ],
  "author": "CABANA",
  "license": "ISC",
  "dependencies": {
    "@fontsource/inter": "^5.0.18",
    "@fontsource/playfair-display": "^5.0.18",
    "next": "^15.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.24",
    "cspell": "^8.19.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "stylelint": "^16.8.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "cross-env": "^7.0.3"
  }
}
