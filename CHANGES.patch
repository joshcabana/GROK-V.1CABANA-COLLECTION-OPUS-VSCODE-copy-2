+        const isOpen = button.getAttribute('aria-expanded') === 'true';
+
+        if (isOpen) {
+          content.classList.add('hidden');
+          icon.style.transform = 'rotate(0deg)';
+          button.setAttribute('aria-expanded', 'false');
+        } else {
+          content.classList.remove('hidden');
+          icon.style.transform = 'rotate(180deg)';
+          button.setAttribute('aria-expanded', 'true');
+
+          // Track FAQ interaction
+          if (typeof gtag !== 'undefined') {
+            gtag('event', 'faq_interaction', {
+              custom_parameter: button.querySelector('h3').textContent,
+            });
+          }
+        }
+      }
+
+      // Category Filtering
+      const categoryButtons = document.querySelectorAll('.faq-category-btn');
+      const faqItems = document.querySelectorAll('.faq-item');
+
+      categoryButtons.forEach((button) => {
+        button.addEventListener('click', () => {
+          const category = button.dataset.category;
+
+          // Update active button
+          categoryButtons.forEach((btn) => {
+            btn.classList.remove('active', 'bg-gold', 'text-black', 'border-gold');
+            btn.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
+          });
+          button.classList.add('active', 'bg-gold', 'text-black', 'border-gold');
+          button.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
+
+          // Filter items
+          let visibleCount = 0;
+          faqItems.forEach((item) => {
+            if (category === 'all' || item.dataset.category === category) {
+              item.style.display = 'block';
+              visibleCount++;
+            } else {
+              item.style.display = 'none';
+            }
+          });
+
+          // Show/hide no results
+          document.getElementById('noResults').classList.toggle('hidden', visibleCount > 0);
+
+          // Track category selection
+          if (typeof gtag !== 'undefined') {
+            gtag('event', 'faq_category_filter', {
+              custom_parameter: category,
+            });
+          }
+        });
+      });
+
+      // Search Functionality
+      const searchInput = document.getElementById('faqSearch');
+
+      searchInput.addEventListener('input', (e) => {
+        const searchTerm = e.target.value.toLowerCase();
+        let visibleCount = 0;
+
+        // Clear previous highlights
+        document.querySelectorAll('.search-highlight').forEach((el) => {
+          el.outerHTML = el.innerHTML;
+        });
+
+        if (searchTerm.length < 2) {
+          // Show all items if search is too short
+          faqItems.forEach((item) => {
+            item.style.display = 'block';
+            visibleCount++;
+          });
+          document.getElementById('noResults').classList.add('hidden');
+          return;
+        }
+
+        faqItems.forEach((item) => {
+          const title = item.querySelector('h3').textContent.toLowerCase();
+          const content = item.querySelector('.faq-content').textContent.toLowerCase();
+          const keywords = item.dataset.keywords ? item.dataset.keywords.toLowerCase() : '';
+
+          if (
+            title.includes(searchTerm) ||
+            content.includes(searchTerm) ||
+            keywords.includes(searchTerm)
+          ) {
+            item.style.display = 'block';
+            visibleCount++;
+
+            // Highlight matching text
+            const titleEl = item.querySelector('h3');
+            const contentEl = item.querySelector('.faq-content');
+
+            [titleEl, contentEl].forEach((el) => {
+              const text = el.innerHTML;
+              const regex = new RegExp(`(${searchTerm})`, 'gi');
+              el.innerHTML = text.replace(regex, '<span class="search-highlight">$1</span>');
+            });
+          } else {
+            item.style.display = 'none';
+          }
+        });
+
+        // Show/hide no results
+        document.getElementById('noResults').classList.toggle('hidden', visibleCount > 0);
+
+        // Track search
+        if (typeof gtag !== 'undefined' && searchTerm.length >= 2) {
+          gtag('event', 'faq_search', {
+            custom_parameter: searchTerm,
+          });
+        }
+      });
