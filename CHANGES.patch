+          this.currentIndex = this.images.findIndex((img) => img.src === src);
+          this.updateDots();
+
+          if (typeof gtag !== 'undefined') {
+            gtag('event', 'product_gallery_view', {
+              image_name: altText,
+              image_index: this.currentIndex,
+            });
+          }
+        }
+
+        initializeSwipeGestures() {
+          if (window.innerWidth > 768) return;
+
+          let startX = 0;
+          let startY = 0;
+
+          const gallery = document.querySelector('.product-gallery');
+
+          gallery.addEventListener(
+            'touchstart',
+            (e) => {
+              startX = e.touches[0].clientX;
+              startY = e.touches[0].clientY;
+            },
+            { passive: true }
+          );
+
+          gallery.addEventListener(
+            'touchmove',
+            (e) => {
+              const deltaX = Math.abs(e.touches[0].clientX - startX);
+              const deltaY = Math.abs(e.touches[0].clientY - startY);
+
+              // Avoid blocking vertical scroll; only hint horizontal intention
+              if (deltaX > deltaY * 1.5) {
+                // no preventDefault to keep scroll fluid
+              }
+            },
+            { passive: true }
+          );
+
+          gallery.addEventListener(
+            'touchend',
+            (e) => {
+              const endX = e.changedTouches[0].clientX;
+              const endY = e.changedTouches[0].clientY;
+
+              const deltaX = endX - startX;
+              const deltaY = endY - startY;
+
+              if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
+                if (deltaX > 0) {
+                  this.previousImage();
+                } else {
+                  this.nextImage();
+                }
+              }
+            },
+            { passive: true }
+          );
+        }
+
+        nextImage() {
+          this.currentIndex = (this.currentIndex + 1) % this.images.length;
+          this.updateGallery();
+        }
+
+        previousImage() {
+          this.currentIndex =
+            this.currentIndex === 0 ? this.images.length - 1 : this.currentIndex - 1;
+          this.updateGallery();
+        }
+
+        updateGallery() {
