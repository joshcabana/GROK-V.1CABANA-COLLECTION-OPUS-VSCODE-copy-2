+          if (entry.isIntersecting) {
+            animateValue(document.getElementById('totalDonated'), 0, 12450, 2000);
+            animateValue(document.getElementById('livesImpacted'), 0, 2490, 2000);
+            observer.unobserve(entry.target);
+          }
+        });
+      });
+
+      const stats = document.querySelector('.impact-stat');
