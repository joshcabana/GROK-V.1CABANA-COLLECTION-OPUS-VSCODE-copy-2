+      // Research-Based Impact Calculator adapted for women's product
+      class ResearchBasedImpactCalculator {
+        constructor() {
+          this.quantity = 1;
+          this.pricePerItem = 50;
+          this.donationPercentage = 0.15;
+
+          // Adjusted cost structure with women's focus (60% women's, 40% men's)
+          this.costStructure = {
+            womensHealth: {
+              healthInformation: 0.34,
+              professionalTraining: 2.55,
+              researchAdvocacy: 5.1,
+              communityOutreach: 0.17,
+            },
+            mensHealth: {
+              crisisSupport: 0.95,
+              educationalMaterials: 2.55,
+              digitalResources: 0.64,
+              awarenessOutreach: 0.31,
+            },
+          };
+
+          this.initializeElements();
+          this.attachEventListeners();
+          this.updateCalculations();
+        }
+
+        initializeElements() {
+          this.quantityInput = document.getElementById('currentQty');
+          this.totalPriceElement = document.getElementById('totalPrice');
+          this.donationAmountElement = document.getElementById('donationAmount');
+          this.increaseQtyBtn = document.getElementById('increaseQty');
+          this.decreaseQtyBtn = document.getElementById('decreaseQty');
+          this.totalPrice = 0;
+          this.donationAmount = 0;
+        }
+
+        attachEventListeners() {
+          this.quantityInput.addEventListener('input', (e) => {
+            this.quantity = parseInt(e.target.value) || 0;
+            this.updateCalculations();
+          });
+
+          this.increaseQtyBtn.addEventListener('click', () => {
+            this.quantity++;
+            this.quantityInput.textContent = this.quantity;
+            this.updateCalculations();
+          });
+
+          this.decreaseQtyBtn.addEventListener('click', () => {
+            this.quantity = Math.max(1, this.quantity - 1);
+            this.quantityInput.textContent = this.quantity;
+            this.updateCalculations();
+          });
+        }
+
+        updateCalculations() {
+          const totalPrice = this.quantity * this.pricePerItem;
+          const donationAmount = totalPrice * this.donationPercentage;
+
+          // 100% goes to women's empowerment on women's page
+          const womensDonation = donationAmount;
+
+          const impacts = {
+            womenHealth: Math.floor(
+              womensDonation / this.costStructure.womensHealth.healthInformation
+            ),
+            womenTraining: Math.floor(
+              womensDonation / this.costStructure.womensHealth.professionalTraining
+            ),
+            womenResearch: Math.floor(
+              womensDonation / this.costStructure.womensHealth.researchAdvocacy
+            ),
+            womenOutreach: Math.floor(
+              womensDonation / this.costStructure.womensHealth.communityOutreach
+            ),
+          };
+
+          // Update display elements (same as men's)
+          this.totalPriceElement.textContent = `$${totalPrice.toFixed(2)} AUD`;
+          this.donationAmountElement.textContent = `$${donationAmount.toFixed(2)} AUD`;
+
+          // Update impact visualization (women's focus only)
+          document.getElementById('womenHealth').textContent = impacts.womenHealth;
+          document.getElementById('womenTraining').textContent = impacts.womenTraining;
+          document.getElementById('womenResearch').textContent = impacts.womenResearch;
+          document.getElementById('womenOutreach').textContent = impacts.womenOutreach;
+
+          // Update total lives impacted (women's focus only)
+          const totalLives =
+            impacts.womenHealth +
+            impacts.womenTraining +
+            impacts.womenResearch +
+            impacts.womenOutreach;
+          document.getElementById('totalLives').textContent = totalLives;
+
+          // Update summary totals (women's focus only)
+          const totalSupport = impacts.womenHealth;
+          const totalEducation = impacts.womenTraining;
